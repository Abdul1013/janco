# ─────────────────────────────────────────────────────────────────────────────
# JANCO Backend — Environment Variables Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Generate a strong JWT_SECRET:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# "development" | "staging" | "production"
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg format)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# HS256 signing secret — must be ≥ 32 random bytes
JWT_SECRET=replace_me_with_secrets_token_hex_32_output
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In production, list only your real frontend domains.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Enables cross-process rate limiter, pricing cache, and WebSocket pub/sub.
# Leave empty to fall back to in-memory (single-process only).
REDIS_URL=redis://localhost:6379/0

# ── Payments (Paystack) ───────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace_me_with_paystack_webhook_secret

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_replace_me
FROM_EMAIL=noreply@janco.app

# ── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Get your DSN from https://sentry.io — leave empty to disable
SENTRY_DSN=

# ── Notifications ────────────────────────────────────────────────────────────
# Set to false in production to send real Expo push notifications
NOTIFICATION_MOCK=true

# ── SMS (Termii) ─────────────────────────────────────────────────────────────
# Janitor alerts & reminders. Set SMS_MOCK=false and fill the key to send real
# SMS. Get an API key from https://accounts.termii.com
SMS_MOCK=true
TERMII_API_KEY=
TERMII_SENDER_ID=JANCO

# ── Scheduled Reminders ──────────────────────────────────────────────────────
# In-process loop that sends 24h-before and same-day booking reminders.
REMINDERS_ENABLED=true
REMINDER_POLL_MINUTES=10
REMINDER_MORNING_HOUR=7
REMINDER_SOON_HOURS=3
# App timezone offset from UTC in hours (Nigeria / WAT = +1)
APP_TZ_OFFSET_HOURS=1

# ── Dojah KYC ────────────────────────────────────────────────────────────────
# Set DOJAH_MOCK=false and fill credentials for real identity verification
DOJAH_MOCK=true
DOJAH_APP_ID=
DOJAH_SECRET=
DOJAH_BASE_URL=https://sandbox.dojah.io
