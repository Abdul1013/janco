# JANCO backend — production environment template
# Copy to `.env.production` or use your secret manager and fill values.

APP_ENV=production
DATABASE_URL=postgresql://user:password@db-host:5432/janco_prod
REDIS_URL=redis://:password@redis-host:6379/0
SENTRY_DSN=
SECRET_KEY=replace-with-random-secret
UVICORN_WORKERS=4
CORS_ORIGINS=https://yourdomain.com
REMINDERS_ENABLED=false

# Optional feature flags / service endpoints
SUPABASE_URL=
SUPABASE_KEY=
